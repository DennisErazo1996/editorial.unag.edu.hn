---
import { MagazineViewer } from "@/components/react/MagazineViewer";

const latestEdition = 
    {
        volume: "VOL. 1 (2026)",
        title: "Innovación agrícola y sostenibilidad",
        date: "15 de marzo de 2026",
        description: "Un número dedicado a las prácticas agroecológicas, la seguridad alimentaria y las tecnologías emergentes aplicadas al campo hondureño.",
        articles: 12,
        authors: 24,
        cover: "/img/demo-portada.png",
        pdfUrl: "/docs/revista/vol1-2026.pdf",
        downloadUrl: "/docs/revista/vol1-2026.pdf"
    }

---

<section class="md:flex-1 md:min-h-0">
    <div class="relative bg-unag-dark-green m-0 mt-2 md:m-5 rounded-t-4xl md:rounded-4xl overflow-hidden min-h-[70vh] ">
        <img src="/img/magazine-asset.png" alt="Fondo de la página" class="absolute hidden md:block select-none w-250 right-0 translate-y-160 translate-x-70 rotate-20" />
        <img src="/img/magazine-asset.png" alt="Fondo de la página" class="absolute select-none w-250 left-0 top-0 md:-translate-x-100 rotate-40" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 h-full">

            <div class="flex justify-center items-center p-6 md:p-10">
                <div class="relative">
                    <div class="absolute -inset-3 rounded-2xl border border-white/15 -z-10"></div>
                    <img src="/img/demo-portada.png" alt="Portada de la Revista" class="max-h-[50vh] md:h-full md:max-h-[75vh] w-auto max-w-full aspect-3/4 object-cover rounded-2xl shadow-2xl" />
                </div>
            </div>

            <div class="relative flex flex-col justify-center items-center text-center md:text-left md:items-start px-8 md:px-6 mb-6">
                <div class="md:absolute scale-85 md:scale-95 mb-3 top-10 right-10 bg-unag-overlay-green rounded-full px-3 py-1 text-sm">
                    <p>Publicado: <span class="font-bold text-unag-dark-green">{latestEdition.date}</span> </p>
                </div>
                <span class="text-unag-yellow text-xs md:text-sm font-bold uppercase tracking-widest mb-3">Última edición publicada</span>
                <h1 class="text-white text-2xl md:text-6xl font-bold leading-tight mb-4">{latestEdition.volume + ': ' + latestEdition.title}</h1>
                <p class="text-white/80 text-xs md:text-sm mb-8 max-w-md">{latestEdition.description}</p>
                <div class="flex flex-col sm:flex-row gap-4">
                   <MagazineViewer
                        client:load
                        pdfUrl={latestEdition.pdfUrl}
                        title={latestEdition.title}
                        volume={latestEdition.volume}
                        variant="primary"
                    />
                    <!-- <a href="/about" class="inline-flex items-center justify-center border border-white/40 hover:border-white text-white font-bold text-sm px-4 py-2 rounded-full transition-colors">Conocer más</a> -->
                </div>
            </div>

        </div>
    </div>
</section>