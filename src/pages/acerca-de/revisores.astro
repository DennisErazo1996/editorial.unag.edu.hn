---
import Footer from '@/components/astro/footer.astro';
import Header from '@/components/astro/header.astro';
import Main from '@/layouts/Main.astro';
import { ClipboardList } from 'lucide-astro';
---

<Main
	title="Revisores | Revista Científica UNAG"
	description="Información para revisores de la Revista Científica UNAG: proceso de revisión por pares de doble ciego y criterios de evaluación de artículos científicos."
>
	<Header />

	<section class="relative bg-[url('/img/bg-pagina.png')] bg-cover bg-center bg-no-repeat">
		<div class="absolute inset-0 bg-linear-to-t from-unag-dark-green via-unag-dark-green/80 to-transparent"></div>
		<div class="relative z-10 max-w-7xl mx-auto -bottom-15 px-5 md:px-0 pt-16 pb-20 md:pt-24 md:pb-40">
			<span class="text-unag-yellow text-xs md:text-sm font-bold uppercase tracking-widest">
				Acerca de
			</span>
			<h1 class="texto-cursiva text-6xl md:text-8xl text-white mt-2">Revisores</h1>
		</div>
	</section>

	<section class="max-w-5xl mx-auto mt-15 md:mt-20 mb-20 p-5 md:p-0">
		<div class="flex items-center gap-3">
			<ClipboardList class="w-7 h-7 text-unag-green shrink-0" />
			<h2 class="texto-cursiva text-4xl md:text-5xl text-unag-dark-green">
				Lista de elementos a revisar en un artículo
			</h2>
		</div>
		<span class="inline-block mt-4 bg-unag-overlay-green text-unag-dark-green text-xs font-semibold rounded-full px-3 py-1">
			Contenido pendiente
		</span>
	</section>

	<Footer />
</Main>
