---
import Footer from '@/components/astro/footer.astro';
import Header from '@/components/astro/header.astro';
import Hero from '@/components/astro/hero.astro';
import Main from '@/layouts/Main.astro';
import { Asciify } from '@/components/react/Asciify';

// Custom ramp: vacío, punto, línea horizontal, línea vertical, diagonal \, diagonal /, triángulo, lleno
const linesAndTriangles = [
	0, 4096, 31744, 4329604, 1118480, 17043521, 33080644, 33554431,
];
---

<Main>
	<div class="min-h-screen flex flex-col">
		<Asciify client:load glyphs={linesAndTriangles} radius={0.4} scale={1} spacing={3} contrast={1.2} background="auto" backgroundOpacity={0}>
			<Header />
			<Hero />
		</Asciify>
	</div>

	<section class="max-w-7xl mx-auto mt-15 md:mt-25 z-1 p-5 md:p-0">
		
			<h1 class="texto-cursiva text-6xl md:text-7xl text-unag-dark-green">Enfoque y Alcance</h1>
			<p class="text-unag-gray mt-2">
				La Revista Científica UNAG es una publicación editada por la Universidad
				Nacional de Agricultura (UNAG), Honduras, desde el año 2026, en formato
				digital, con enfoque en las ciencias agropecuarias y áreas afines, y con revisión
				por pares de doble ciego. Su objetivo es difundir la producción científica de
				docentes e investigadores, en un inicio de la propia UNAG, con proyección a
				ampliarse a investigadores nacionales, en los diversos campos relacionados
				con la producción agropecuaria, el desarrollo rural y la sostenibilidad.
			</p>
		
	</section>

	<section class="max-w-7xl mx-auto mt-25 mb-15 z-1 p-3 md:p-0">
		<h1 class="texto-cursiva text-6xl md:text-7xl text-unag-dark-green">Artículos Publicables</h1>
		<div class="grid grid-cols-2 md:grid-cols-3 gap-1 md:gap-20 md:mt-9">
			<div class="flex flex-col justify-center md:items-center scale-75 md:scale-100 border-l border-t rounded-tl-4xl border-l-unag-dark-green border-t-unag-dark-green p-3 md:p-0">
				<h2 class="text-unag-gray/15 text-9xl md:text-[130px] font-bold leading-none">01</h2>
				<p class="text-unag-gray leading-none font-black text-2xl md:text-3xl">
					Artículos <br> <span class="text-unag-green">científicos</span>
				</p>
			</div>
			<div class="flex flex-col justify-center md:items-center scale-75 md:scale-100 border-l border-t rounded-tl-4xl border-l-unag-dark-green border-t-unag-dark-green p-3 md:p-0">
				<h2 class="text-unag-light-gray text-9xl md:text-[130px] font-bold leading-none">02</h2>
				<p class="text-unag-gray leading-none font-black text-2xl md:text-3xl">
					Notas <br> <span class="text-unag-green">científicas</span>
				</p>
			</div>
			<div class="flex flex-col justify-center md:items-center scale-75 md:scale-100 border-l border-t rounded-tl-4xl border-l-unag-dark-green border-t-unag-dark-green p-3 md:p-0">
				<h2 class="text-unag-gray/15 text-9xl md:text-[130px] font-bold leading-none">03</h2>
				<p class="text-unag-gray leading-none font-black text-2xl md:text-3xl">
					Artículos de <br> <span class="text-unag-green">revisión</span>
				</p>
			</div>
			<div class="flex flex-col justify-center md:items-center scale-75 md:scale-100">
				<h2 class="text-unag-light-gray text-9xl md:text-[130px] font-bold leading-none">04</h2>
				<p class="text-unag-gray leading-none font-black text-2xl md:text-3xl">
					Ensayos <br> <span class="text-unag-green">académicos</span>
				</p>
			</div>
			<div class="flex flex-col justify-center md:items-center scale-75 md:scale-100 border-l border-t rounded-tl-4xl border-l-unag-dark-green border-t-unag-dark-green p-3 md:p-0">
				<h2 class="text-unag-gray/15 text-9xl md:text-[130px] font-bold leading-none">05</h2>
				<p class="text-unag-gray leading-none font-black text-2xl md:text-3xl">
					Notas <br> <span class="text-unag-green">técnicas</span>
				</p>
			</div>
			<div class="flex flex-col justify-center md:items-center scale-75 md:scale-100">
				<h2 class="text-unag-light-gray text-9xl md:text-[130px] font-bold leading-none">06</h2>
				<p class="text-unag-gray leading-none font-black text-2xl md:text-3xl">
					Estudios de <br> <span class="text-unag-green">caso</span>
				</p>
			</div>

		</div>
	</section>

	
	<Footer />
	
</Main>
