---
import Footer from '@/components/astro/footer.astro';
import Header from '@/components/astro/header.astro';
import Hero from '@/components/astro/hero.astro';
import Main from '@/layouts/Main.astro';
import { Asciify } from '@/components/react/Asciify';
import { FlaskConical, FileText, BookOpen, PenTool, Wrench, ClipboardList } from 'lucide-astro';

// Custom ramp: vacío, punto, línea horizontal, línea vertical, diagonal \, diagonal /, triángulo, lleno
const linesAndTriangles = [
	0, 4096, 31744, 4329604, 1118480, 17043521, 33080644, 33554431,
];

const articulosPublicables = [
	{
		numero: '01',
		nombre: 'Artículos científicos',
		icon: FlaskConical,
	},
	{
		numero: '02',
		nombre: 'Notas científicas',
		icon: FileText,
	},
	{
		numero: '03',
		nombre: 'Artículos de revisión',
		icon: BookOpen,
	},
	{
		numero: '04',
		nombre: 'Ensayos académicos',
		icon: PenTool,
	},
	{
		numero: '05',
		nombre: 'Notas técnicas',
		icon: Wrench,
	},
	{
		numero: '06',
		nombre: 'Estudios de caso',
		icon: ClipboardList,
	},
]
---

<Main>
	<div class="min-h-screen flex flex-col">
		<Asciify client:load glyphs={linesAndTriangles} radius={0.4} scale={1} spacing={3} contrast={1.2} background="auto" backgroundOpacity={0}>
			<Header />
			<Hero />
		</Asciify>
	</div>

	<section class="max-w-7xl mx-auto mt-15 md:mt-25 z-1 p-5 md:p-0">
		
			<h1 class="texto-cursiva text-6xl md:text-7xl text-unag-dark-green">Enfoque y Alcance</h1>
			<p class="text-unag-gray mt-2">
				La Revista Científica UNAG es una publicación editada por la Universidad
				Nacional de Agricultura (UNAG), Honduras, desde el año 2026, en formato
				digital, con enfoque en las ciencias agropecuarias y áreas afines, y con revisión
				por pares de doble ciego. Su objetivo es difundir la producción científica de
				docentes e investigadores, en un inicio de la propia UNAG, con proyección a
				ampliarse a investigadores nacionales, en los diversos campos relacionados
				con la producción agropecuaria, el desarrollo rural y la sostenibilidad.
			</p>
		
	</section>

	<section class="max-w-7xl mx-auto mt-20 md:mt-35 mb-15 z-1 p-5 md:p-0">
		<h1 class="texto-cursiva text-6xl md:text-7xl text-unag-dark-green">Artículos Publicables</h1>
		<div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 mt-8 md:mt-9">
			{
				articulosPublicables.map((item) => (
					<div class="group relative flex flex-col items-start gap-4 rounded-2xl border border-unag-gray/15 p-5 md:p-6 transition-all hover:border-unag-dark-green hover:shadow-lg">
						<span class="absolute top-4 right-5 text-unag-gray/20 font-black text-4xl">
							{item.numero}
						</span>
						<div class="flex items-center justify-center w-12 h-12 rounded-full bg-unag-dark-green/5 text-unag-dark-green transition-colors group-hover:bg-unag-dark-green group-hover:text-white">
							<item.icon size={24} />
						</div>
						<p class="text-unag-dark-green font-black text-lg md:text-xl leading-tight">
							{item.nombre}
						</p>
					</div>
				))
			}
		</div>
	</section>

	
	<Footer />
	
</Main>
