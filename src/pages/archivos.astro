---
import Footer from '@/components/astro/footer.astro';
import Header from '@/components/astro/header.astro';
import Main from '@/layouts/Main.astro';
import { DocumentTabs } from '@/components/react/DocumentTabs';

interface DocFile {
  code: string;
  title: string;
  file: string;
}

interface Tab {
  id: string;
  label: string;
  basePath: string;
  files: DocFile[];
}

