---

<Main
  title="Archivos | Revista Científica UNAG"
  description="Formatos y documentos oficiales de la Revista Científica UNAG: plantillas para autores, editores, comité de ética y publicaciones."
>
  <Header />

  <section class="relative bg-[url('/img/bg-pagina.png')] bg-cover bg-center bg-no-repeat">
    <div class="absolute inset-0 bg-linear-to-t from-unag-dark-green via-unag-dark-green/80 to-transparent"></div>
    <div class="relative z-10 max-w-7xl mx-auto -bottom-15 px-5 md:px-0 pt-16 pb-20 md:pt-24 md:pb-40">
      <span class="text-unag-yellow text-xs md:text-sm font-bold uppercase tracking-widest">
        Sistema de Gestión Editorial
      </span>
      <h1 class="texto-cursiva text-6xl md:text-8xl text-white mt-2">Archivos</h1>
    </div>
  </section>

  <section class="max-w-5xl mx-auto mt-15 md:mt-20 mb-20 px-5 md:px-0">
    <DocumentTabs tabs={tabs} client:load />
  </section>

  <Footer />
</Main>
